#!/bin/sh
# Assert that a fresh install ASKS — in a terminal, without being told to.
#
#   sh scripts/check-first-ask [<rlp binary>]
#   sh scripts/check-first-ask --detected [<rlp binary>]
#
# `scripts/check-first-run` judges the *report* a new host gets from `rlp doctor`.
# This judges the thing a person actually experiences first: start `rlp` on a host
# with no credential and no model arms, and the guided setup should begin by
# itself — the mode, then the endpoints, then the models — rather than waiting for
# somebody to know the word `/setup`. That is a behaviour of the running TUI, so
# it can only be checked from the running TUI, which is what this does: a real
# session under a real pty, with the keystrokes a hesitant user would press
# (escape, over and over), and assertions on what the terminal showed.
#
# Three properties are worth pinning, and each has been broken before:
#
#   1. it asks. A first run that says nothing is a first run nobody finishes;
#   2. cancelling writes nothing. Asking is only safe because "esc esc esc" is a
#      complete answer, so the ladder must come out byte-identical;
#   3. it is not a trap. RLP_NO_SETUP=1 must produce a silent start, because a
#      scripted or supervised launch has nobody at the keyboard to answer, and a
#      tool that ambushes those sessions gets disabled wholesale.
#
# `--detected` swaps the scenario to a host that *does* have external coding CLIs:
# it puts fake `claude`/`jcode` binaries on PATH and a `~/.claude.json` marker,
# leaves RLP_HARNESS_SCAN on, and asserts the new tool-detection step actually
# shows in the wizard — plus the same guarantee that cancelling it writes nothing.
# The default path pins RLP_HARNESS_SCAN=0 so the five core needles stay
# byte-identical on every host, whether or not it has coding CLIs installed.
#
# Env: none required. Needs `script` (util-linux) for the pty; outside CI it
# reports a skip rather than failing, since macOS ships a `script` with different
# flags and this check is about RLP's behaviour, not about the host's toolkit.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RLP="$ROOT/scripts/rlp"
DETECTED=""
for arg in "$@"; do
  case "$arg" in
    --detected) DETECTED=1 ;;
    *) RLP="$arg" ;;
  esac
done
T=$(mktemp -d "${TMPDIR:-/tmp}/rlp-ask.XXXXXX")
trap 'rm -rf "$T"' EXIT

[ -x "$RLP" ] || { echo "check-first-ask: no rlp binary at $RLP" >&2; exit 2; }

if ! command -v script >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    echo "check-first-ask: CI must run this check, and \`script\` (util-linux) is missing" >&2
    exit 1
  fi
  echo "check-first-ask: skipped — no \`script\` binary for a pty on this host"
  exit 0
fi

# --- a throwaway "fresh install" -----------------------------------------------
# A real agent dir built from this checkout, with an empty provider store and the
# ladder exactly as it ships. Nothing here touches ~/.rlp: HOME moves the
# harness's own state, RLP_CODING_AGENT_DIR moves RLP's, and the two credential
# files are pointed into the sandbox so a stray write cannot reach a real key.
mkdir -p "$T/home"
RLP_CODING_AGENT_DIR="$T/agent" RLP_NO_MIGRATE=1 RLP_QUIET=1 sh "$ROOT/scripts/sync-agent-dir" "$ROOT" >/dev/null 2>&1 || {
  echo "check-first-ask: sync-agent-dir failed into $T/agent" >&2
  exit 2
}
cp "$ROOT/agent/rlp/orchestration.json" "$T/agent/orchestration.json"
printf '{}\n' > "$T/agent/models.json"
printf '{}\n' > "$T/agent/auth.json"
chmod 600 "$T/agent/models.json" "$T/agent/auth.json"
BEFORE=$(cksum "$T/agent/orchestration.json")

# One escape per question, spaced out: the wizard asks several, some of them after
# a python subprocess has answered, and a burst of keystrokes would be swallowed
# rather than answered. `--no-session` keeps the sandbox's session dir empty.
cancel_keystrokes() {
  sleep "${RLP_ASK_START:-14}"
  i=0
  while [ $i -lt 10 ]; do
    printf '\033'
    i=$((i + 1))
    sleep 2
  done
  sleep 6
}

run_session() {
  # $1: log file. Everything else is the same environment a person would have.
  # RLP_HARNESS_SCAN=0 pins the tool-detection step shut: the five-needle
  # assertions below are about the *core* wizard, and they must read byte-for-
  # byte the same on a bare CI host and on a machine that has four coding CLIs
  # on PATH. Without it, the detection question would fire here (this host has
  # claude) and shift every keystroke after Step 1. The detection path gets its
  # own scripted run below (the `--detected` branch) with fake CLIs instead.
  cancel_keystrokes | env -i \
    PATH="$PATH" \
    HOME="$T/home" \
    TERM="${TERM:-xterm-256color}" \
    COLUMNS=120 LINES=40 \
    RLP_CODING_AGENT_DIR="$T/agent" \
    RLP_ROOT="$ROOT" \
    RLP_PI_MODELS="$T/agent/models.json" \
    RLP_PI_AUTH="$T/agent/auth.json" \
    RLP_HARNESS_SCAN=0 \
    ${RLP_QUIET_RUN:+RLP_NO_SETUP=1} \
    timeout "${RLP_ASK_TIMEOUT:-180}" script -qec "$RLP --no-session" "$1" >/dev/null 2>&1 || true
  [ -s "$1" ] || { echo "check-first-ask: no session output in $1" >&2; exit 1; }
}

run_detected_session() {
  # A host that *has* external CLIs. The fakes are never run — `harness scan
  # --no-versions` is PATH-lookup only — so a plain `which()` hit is all they
  # need to be. HOME stays the sandbox, so the `~/.claude.json` marker makes
  # claude read as logged-in while jcode (no marker, no key env under env -i)
  # reads as needing login: both are "fresh tools", and both must be offered.
  mkdir -p "$T/fakebin"
  printf '#!/bin/sh\necho fake\n' > "$T/fakebin/claude"
  printf '#!/bin/sh\necho fake\n' > "$T/fakebin/jcode"
  chmod +x "$T/fakebin/claude" "$T/fakebin/jcode"
  printf '{}\n' > "$T/home/.claude.json"
  # $1: log file. Same env as run_session, minus RLP_HARNESS_SCAN=0, plus the
  # fake CLIs at the front of PATH and the claude marker under HOME.
  cancel_keystrokes | env -i \
    PATH="$T/fakebin:$PATH" \
    HOME="$T/home" \
    TERM="${TERM:-xterm-256color}" \
    COLUMNS=120 LINES=40 \
    RLP_CODING_AGENT_DIR="$T/agent" \
    RLP_ROOT="$ROOT" \
    RLP_PI_MODELS="$T/agent/models.json" \
    RLP_PI_AUTH="$T/agent/auth.json" \
    timeout "${RLP_ASK_TIMEOUT:-180}" script -qec "$RLP --no-session" "$1" >/dev/null 2>&1 || true
  [ -s "$1" ] || { echo "check-first-ask: no session output in $1" >&2; exit 1; }
}

if [ -n "$DETECTED" ]; then
  run_detected_session "$T/detected.log"
else
  run_session "$T/ask.log"
  RLP_QUIET_RUN=1 run_session "$T/quiet.log"
fi

# --- the assertions -------------------------------------------------------------
RLP_T="$T" RLP_BEFORE="$BEFORE" RLP_MODE="${DETECTED:+detected}" \
  python3 - "$T/agent/orchestration.json" <<'PY'
import os
import re
import sys

ANSI = re.compile(r"\x1b\][^\x07\x1b]*(\x07|\x1b\\)?|\x1b\[[0-9;?]*[A-Za-z]|\x1b[@-_][0-?]*[ -/]*[@-~]")


def text(path):
    raw = open(path, "rb").read().decode("utf-8", "replace")
    return ANSI.sub("", raw)


problems = []
root = os.environ["RLP_T"]
detected = os.environ.get("RLP_MODE") == "detected"
ladder_path = sys.argv[1]
loud = text(f"{root}/detected.log" if detected else f"{root}/ask.log")
hushed = "" if detected else text(f"{root}/quiet.log")

# 1. it asks, and asks the first question that matters. The five core needles are
#    the same in both scenarios; `--detected` adds the tool-detection step, which
#    on a host with external CLIs must show up before the endpoints question.
needles = [
    ("first run", "a first run says why it is interrupting you"),
    ("Step 1 of 5", "the first question is what this host does with a request"),
    ("Direct only", "and the direct-only mode is offered by name, not buried"),
    ("Step 2 of 5", "the endpoints question follows"),
    ("setup done", "cancelling everything still lands on a summary, not a dead end"),
]
if detected:
    needles.insert(3, ("tools this host already has", "a host with external CLIs is offered them"))
for needle, why in needles:
    if needle not in loud:
        problems.append(f"the first run never showed {needle!r} — {why}")

# 2. cancelling wrote nothing. The keystrokes answered every question with
#    escape, so the ladder must be the file that shipped — in the detected case
#    this is the load-bearing one: the tool-detection step must be cancel-safe,
#    or a scan would rewrite the ladder out from under a user who declined.
before = os.environ["RLP_BEFORE"]
import subprocess

after = subprocess.run(["cksum", ladder_path], capture_output=True, text=True).stdout.strip()
if after != before:
    problems.append(f"cancelling the wizard changed the ladder:\n    before {before}\n    after  {after}")

# 3. the opt-out means it. RLP_NO_SETUP is the difference between a guided first
#    run and a tool that cannot be scripted; if the questions keep coming with it
#    set, people disable the extension rather than the prompt. (Only the default
#    scenario runs the quiet session; `--detected` is about the scan, not the
#    opt-out, and RLP_NO_SETUP already short-circuits before any scan.)
if not detected:
    for needle in ("first run", "Step 1 of 5"):
        if needle in hushed:
            problems.append(f"RLP_NO_SETUP=1 still asked ({needle!r}) — the quiet start is not quiet")

if problems:
    print("first-ask check FAILED:")
    for p in problems:
        print(f"  - {p}")
    head = "\n    ".join(loud.splitlines()[-25:])
    print(f"  last lines of the session:\n    {head}")
    sys.exit(1)

if detected:
    print("  detected-host check ok: external CLIs are offered, and cancelling the offer writes nothing")
else:
    print("  first-run check ok: a fresh host is asked, escape is a complete answer, RLP_NO_SETUP is honoured")
PY
