#!/bin/sh
# rlp — the RLP tool. One entry point.
#
#   rlp                     the agent: the pi fork TUI, with RLP loaded
#   rlp -p "request"        one shot, same agent, non-interactive
#   rlp <subcommand>        the decision engine: plan, triage, decompose, route,
#                           ladder, roster, doctor, serve, version
#   rlp update              one updater: RLP's own checkout, then the fork
#                           under it (`rpi update` is the same command)
#
# Orchestration is local: the RLP extension dispatches headless rpi workers,
# one git worktree per node, and collects their results back into this session.
# The laya gate still decides whether to orchestrate at all, so a small request
# never pays for a fan-out — and it needs no server, daemon or runner to do it.
set -eu

# Resolve $0 through any symlinks (~/.local/bin/rlp -> <checkout>/scripts/rlp)
# so the project root is found from the real script location, not the link.
SELF=$0
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF=$LINK ;;
    *)  SELF=$(dirname -- "$SELF")/$LINK ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
export RLP_ROOT="$ROOT"
# The engine python: a legacy .venv when present, else any PATH python that can
# import rlp_svc (a plain pip install). No venv required.
SVC_PY=$(sh "$ROOT/scripts/svc-py" 2>/dev/null || true)

# Subcommands owned by the decision engine. Anything else belongs to the agent,
# including the harness's own flags (-p, --model, ...).
case "${1:-}" in
  plan|triage|decompose|route|llm-route|ladder|mode|roster|config|replan|digest|verify|memory|remember|doctor|progress|serve|engine|provider|version|harness)
    if [ -z "$SVC_PY" ]; then
      echo "rlp: decision engine not installed." >&2
      echo "     run: sh $ROOT/scripts/install.sh" >&2
      exit 1
    fi
    exec "$SVC_PY" -m rlp_svc "$@"
    ;;
  update)
    # Shift off "update" and pass the rest; passing "${2:-}" would hand the
    # script an empty argument when there are none, which it reads as a bad
    # option.
    shift
    exec "$ROOT/scripts/rlp-update" "$@"
    ;;
esac

if [ "${1:-}" = "help-tool" ] || [ "${1:-}" = "--rlp-help" ]; then
  cat <<'USAGE'
rlp — Recursive Laya Pi

FIRST RUN: start `rlp` and it asks. A host with no credential and no model arms
has nothing to work with, so the first session runs the guided setup: the mode,
the endpoints and their keys, the model RLP works on, the worker arms and the
per-role models. Every question is skippable; `RLP_NO_SETUP=1` keeps the old
quiet start. `/setup` reruns it by hand, and `rlp doctor` says the same thing
without a TUI.

  rlp                        the agent: triage, then local waves of workers when
                             the gate says so
  rlp --direct               the same agent, never orchestrating (this session)
  rlp -p "<request>"         the same, non-interactive
                             (RLP_DIRECT=1 for the same effect in any position)

  rlp plan "<request>"       triage gate + DAG + per-node routing + dispatch waves
  rlp triage "<request>"     direct vs orchestrate, one laya forward pass
  rlp decompose "<request>"  the DAG on its own
  rlp route --title T ...    route one subtask to a worker
  rlp ladder | roster        the model ladder and the derived router cards
  rlp mode                   direct-only or full: does this host orchestrate?
  rlp mode direct|full       set it (also /direct on|off inside a session)
  rlp config '<ops-json>'    edit the ladder (validated, backed up, atomic)
  rlp verify --acceptance A  independent cross-vendor best-of-N verdict
  rlp memory | remember T    the project's cross-run knowledge log
  rlp replan FOCUS           recursively re-decompose one task into a sub-DAG
  rlp digest [--run ID]      condense a finished wave's reports into a handoff
                             (RLM over reports — the `engine` line says who wrote it)
  rlp provider ...           endpoints and credentials: list|add|remove|key|
                             discover|probe|scan|import|
                             (scan|import: pi's own providers, copied in)
  rlp harness [scan|list]    which coding CLIs can run workers here (omp,
                             claude, jcode, muse — present? logged in?)
  rlp doctor [--warm]        is this host runnable? (fixes per line)
  rlp progress               how far this host is from installed to working, and
                             the next step — the same rule the first run asks by
  rlp serve                  the decision engine as an MCP stdio server
  rlp update [--check]       one updater: RLP and the fork under it
                             (`rpi update` is the same command)
  rpi                        the same harness, no orchestration surface

In-session: /setup /direct /provider /rlp-plan /rlp-state /rlp-doctor
            /rlp-ladder /rlp-config /rlp-roles /models /commands
Machine-readable: add --json to any engine subcommand.
USAGE
  exit 0
fi

# Everything else is the agent: the fork's own CLI, so rlp is a superset of
# rpi. Orchestration comes from the RLP extension, not from a launcher.

# --direct is the one flag this launcher owns, because "do not orchestrate this
# time" is a property of the session rather than of the ladder: it sets
# $RLP_DIRECT — which the engine and the extensions both read — and the harness
# never sees the flag. The ladder is untouched, so the next session is back to
# whatever it says.
#
# First argument only, and deliberately so: rebuilding "$@" in POSIX sh either
# word-splits or evals, and a launcher that breaks `rlp -p "a request with
# spaces"` is worse than one that asks for the flag up front. `RLP_DIRECT=1 rlp …`
# and `/direct on` inside a session cover every other position.
if [ "${1:-}" = "--direct" ]; then
  RLP_DIRECT=1
  export RLP_DIRECT
  shift
  echo "rlp: direct-only for this session — every request inline, no gate, no workers." >&2
  echo "     the ladder is untouched: /direct on, or \`rlp mode direct\`, to make it stick." >&2
fi

RPI="$ROOT/scripts/rpi-bin"
if [ ! -x "$RPI" ]; then
  echo "rlp: the harness is not built (no $RPI)." >&2
  echo "     run: sh $ROOT/scripts/install.sh" >&2
  exit 1
fi

# One binary, two names. The fork renders whichever identity was asked for, so
# `rlp` says RLP with an RLP mark and `rpi` stays the bare harness instead of
# both claiming the same brand.
RLP_IDENTITY=rlp
RLP_ROOT="$ROOT"
export RLP_IDENTITY RLP_ROOT
exec "$RPI" "$@"
