+/**
+ * Parse the RLP launcher's default-model override.
+ *
+ * `RPI_DEFAULT_MODEL` uses the same `provider/model` spelling as `--model`, so
+ * one variable pins both halves and
+ * `RPI_DEFAULT_MODEL=qwen-token-plan/deepseek-v4.1-flash rpi` works as typed.
+ * A value without a slash sets only the model id and leaves the provider to
+ * the saved setting.
+ */
+function rlpDefaultFromEnv(): { provider?: string; model?: string } {
+	const raw = process.env.RPI_DEFAULT_MODEL;
+	const slash = raw?.indexOf("/") ?? -1;
+	if (raw && slash > 0) {
+		return { provider: raw.slice(0, slash), model: raw.slice(slash + 1) };
+	}
+	return { model: raw };
+}
+
+/**
+ * Is this a dispatched worker rather than a person at a prompt?
+ *
+ * A worker is launched headless (`--mode rpc`, or `--no-session`) and is passed
+ * `--model` explicitly when the dispatch named one. The two cases want opposite
+ * things from a default:
+ *
+ *   - a worker with no `--model` should inherit the RLP ladder's default, or
+ *     dispatching outside the configured ladder arms is silent;
+ *   - an interactive session belongs to its user, and a default they chose in
+ *     `/settings` or pinned with Ctrl+S in `/model` must survive the next
+ *     launch. Shadowing it made those two commands look broken.
+ *
