index 000000000..a0f6d2c4f
--- /dev/null
+++ b/packages/coding-agent/src/core/rlp-orchestration.ts
@@ -0,0 +1,342 @@
+/**
+ * RLP orchestration config — the model ladder the orchestrator plans and
+ * dispatches against.
+ *
+ * Loaded from `$RLP_ORCHESTRATION` when set, else `<agentDir>/orchestration.json`.
+ * When present it is rendered into its own `rlp_orchestration` system-prompt
+ * section, so the routing ladder is configuration rather than prose baked into
+ * an agent persona. Absent config = no section, and the harness behaves like
+ * plain pi.
+ *
+ * Shape:
+ *   {
+ *     "brain": "agnes/agnes-3.0-flash",
+ *     "workers": [
+ *       { "id": "pi", "harness": "pi",
+ *         "models": [
+ *           { "model": "qwen-token-plan/qwen3.8-flash",
+ *             "roles": ["explore", "docs", "review"], "when": "fast fan-out" }
+ *         ] }
+ *     ],
+ *     "routing": { "escalateBelow": 0.55, "maxDispatchesPerTurn": 4 },
+ *     "review": { "crossVendor": true }
+ *   }
+ */
+
+import { existsSync, readFileSync, statSync } from "node:fs";
+import { isAbsolute, resolve } from "node:path";
+import { getAgentDir } from "../config.ts";
+
+export interface OrchestrationModel {
+	/** `provider/model`, exactly as passed to `args.model` on a dispatch. */
+	model: string;
+	/** Task domains this model is preferred for. */
+	roles: string[];
+	/** One line of guidance: when to reach for this arm. */
+	when: string;
+}
+
+export interface OrchestrationWorker {
+	/** Worker/agent id, e.g. `pi`, `claude_code`. */
+	id: string;
+	/** Harness the worker boots on, e.g. `pi`, `claude-native`. */
+	harness?: string;
+	/**
+	 * Whether this host can currently serve the worker. Omitted means true.
+	 * An unavailable worker is kept in the ladder (so the operator can see and
+	 * re-enable it) but is never a routing target.
+	 */
+	available?: boolean;
+	/** Why the worker is unavailable, in the operator's words. */
+	availabilityNote?: string;
+	/** Model ladder for this worker, most-preferred first. */
+	models: OrchestrationModel[];
+}
+
+export interface OrchestrationConfig {
+	/** Provider/model the orchestrator itself runs on. */
+	brain: string;
+	workers: OrchestrationWorker[];
+	routing: {
+		/** Re-route when the router's confidence falls below this. */
+		escalateBelow?: number;
+		/** Cap on dispatches per turn. */
+		maxDispatchesPerTurn?: number;
+	};
+	review: {
+		/** Review nodes must run on a different vendor than the implementer. */
+		crossVendor: boolean;
+	};
+}
+
+const CONFIG_FILE_NAME = "orchestration.json";
+
+/** Path the config is read from, for display and diagnostics. */
+export function orchestrationConfigPath(): string {
+	const override = process.env.RLP_ORCHESTRATION;
+	if (!override) return resolve(getAgentDir(), CONFIG_FILE_NAME);
+	return isAbsolute(override) ? override : resolve(process.cwd(), override);
+}
+
+function nonEmptyString(value: unknown, where: string): string {
+	if (typeof value !== "string" || value.trim() === "") {
+		throw new Error(`${where} must be a non-empty string`);
+	}
+	return value;
+}
+
+function stringArray(value: unknown, where: string): string[] {
+	if (!Array.isArray(value) || value.length === 0) {
+		throw new Error(`${where} must be a non-empty array of strings`);
+	}
+	for (const entry of value) {
+		if (typeof entry !== "string" || entry === "") {
+			throw new Error(`${where} must be a non-empty array of strings`);
+		}
+	}
+	return value as string[];
+}
+
+function modelRef(value: unknown, where: string): string {
+	const ref = nonEmptyString(value, where);
+	if (!ref.includes("/")) throw new Error(`${where} must be a "provider/model" string`);
+	return ref;
+}
+
+function parseWorkers(value: unknown, source: string): OrchestrationWorker[] {
+	if (!Array.isArray(value) || value.length === 0) {
+		throw new Error(`${source}: 'workers' must be a non-empty array`);
+	}
+	const seenWorkerIds = new Set<string>();
+	const workers: OrchestrationWorker[] = [];
+	for (const [i, rawWorker] of value.entries()) {
+		const where = `workers[${i}]`;
+		const worker = rawWorker as Record<string, unknown>;
+		if (typeof rawWorker !== "object" || rawWorker === null || Array.isArray(rawWorker)) {
+			throw new Error(`${source}: ${where} must be an object`);
+		}
+		const id = nonEmptyString(worker.id, `${source}: ${where}.id`);
+		if (seenWorkerIds.has(id)) throw new Error(`${source}: duplicate worker id ${JSON.stringify(id)}`);
+		seenWorkerIds.add(id);
+		if (worker.harness !== undefined && typeof worker.harness !== "string") {
+			throw new Error(`${source}: ${where}.harness must be a string`);
+		}
+		if (worker.available !== undefined && typeof worker.available !== "boolean") {
+			throw new Error(`${source}: ${where}.available must be a boolean`);
+		}
+		if (worker.availabilityNote !== undefined && typeof worker.availabilityNote !== "string") {
+			throw new Error(`${source}: ${where}.availabilityNote must be a string`);
+		}
+
+		if (!Array.isArray(worker.models)) {
+			throw new Error(`${source}: worker ${JSON.stringify(id)} must have a 'models' array`);
+		}
+		// An empty `models` array is the shipped default: RLP carries no arms on
+		// purpose (`"brain": null` + every worker empty), so `/setup` writes them
+		// from the connected providers rather than guessing. A worker with no
+		// arms parses fine and simply renders no ladder lines; only a missing or
+		// wrong-typed `models` key is a real shape error.
+		const models: OrchestrationModel[] = [];
+		for (const [j, rawModel] of worker.models.entries()) {
+			const modelWhere = `${source}: worker ${JSON.stringify(id)} models[${j}]`;
+			if (typeof rawModel !== "object" || rawModel === null || Array.isArray(rawModel)) {
+				throw new Error(`${modelWhere} must be an object`);
+			}
+			const entry = rawModel as Record<string, unknown>;
+			models.push({
+				model: modelRef(entry.model, `${modelWhere}.model`),
+				roles: stringArray(entry.roles, `${modelWhere}.roles`),
+				when: nonEmptyString(entry.when, `${modelWhere}.when`),
+			});
+		}
+		workers.push({
+			id,
+			harness: worker.harness as string | undefined,
+			available: worker.available as boolean | undefined,
+			availabilityNote: worker.availabilityNote as string | undefined,
+			models,
+		});
+	}
+	return workers;
+}
+
+/**
+ * Parse and validate the config. Throws on malformed JSON or a shape that
+ * cannot render — a broken ladder is a setup error worth surfacing loudly, not
+ * something to silently drop from the prompt.
+ *
+ * One deliberate exception: the shipped default is a policy-only ladder —
+ * `"brain": null` and every worker carrying an empty `models` array. RLP ships
+ * no arms on purpose: a model ref only means something on a host that has that
+ * provider, so `/setup` writes them from the endpoints it connected rather
+ * than guessing and failing at the worker. That state is not an error, it is
+ * the starting point, so a parser that threw on it made the bare `rlp` boot
+ * crash with "'brain' must be a non-empty string" before the user could run
+ * `/setup` at all. Such a ladder parses to a config that renders to nothing
+ * (see `renderOrchestration`) instead of throwing.
+ */
+export function parseOrchestration(raw: string, source: string): OrchestrationConfig | undefined {
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(raw);
+	} catch (e) {
+		throw new Error(`${source}: invalid JSON (${e instanceof Error ? e.message : String(e)})`);
+	}
+	if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+		throw new Error(`${source}: expected a JSON object`);
+	}
+	const config = parsed as Record<string, unknown>;
+
+	let escalateBelow: number | undefined;
+	let maxDispatchesPerTurn: number | undefined;
+	if (config.routing !== undefined) {
+		if (typeof config.routing !== "object" || config.routing === null || Array.isArray(config.routing)) {
+			throw new Error(`${source}: 'routing' must be an object`);
+		}
+		const routing = config.routing as Record<string, unknown>;
+		if (routing.escalateBelow !== undefined) {
+			if (typeof routing.escalateBelow !== "number" || routing.escalateBelow < 0 || routing.escalateBelow > 1) {
+				throw new Error(`${source}: routing.escalateBelow must be a number in [0, 1]`);
+			}
+			escalateBelow = routing.escalateBelow;
+		}
+		if (routing.maxDispatchesPerTurn !== undefined) {
+			const cap = routing.maxDispatchesPerTurn;
+			if (typeof cap !== "number" || !Number.isInteger(cap) || cap < 1) {
+				throw new Error(`${source}: routing.maxDispatchesPerTurn must be a positive integer`);
+			}
+			maxDispatchesPerTurn = cap;
+		}
+	}
+
+	let crossVendor = false;
+	if (config.review !== undefined) {
+		if (typeof config.review !== "object" || config.review === null || Array.isArray(config.review)) {
+			throw new Error(`${source}: 'review' must be an object`);
+		}
+		const review = config.review as Record<string, unknown>;
+		if (review.crossVendor !== undefined) {
+			if (typeof review.crossVendor !== "boolean") {
+				throw new Error(`${source}: review.crossVendor must be a boolean`);
+			}
+			crossVendor = review.crossVendor;
+		}
+	}
+
+	// A ladder with no brain and no arms is the shipped default, not a broken
+	// one: `brain` null plus every worker's `models` empty means "/setup has
+	// not run yet" and must parse to a config that renders to nothing rather
+	// than throw and block the first launch.
+	const isUnconfigured =
+		(config.brain === null || config.brain === undefined) &&
+		parseWorkers(config.workers, source).every((worker) => worker.models.length === 0);
+	if (isUnconfigured) {
+		return {
+			brain: undefined as unknown as string, // no brain yet; see `renderOrchestration`
+			workers: parseWorkers(config.workers, source),
+			routing: { escalateBelow, maxDispatchesPerTurn },
+			review: { crossVendor },
+		};
+	}
+
+	return {
+		brain: modelRef(config.brain, `${source}: 'brain'`),
+		workers: parseWorkers(config.workers, source),
+		routing: { escalateBelow, maxDispatchesPerTurn },
+		review: { crossVendor },
+	};
+}
+
+let cached: { path: string; mtimeMs: number; config: OrchestrationConfig | undefined } | undefined;
+
+/**
+ * The orchestration config for this process, or undefined when none is
+ * configured — including the shipped policy-only default (no brain, no arms).
+ * Cached against the file's mtime so a long-lived session picks up an edit on
+ * the next prompt rebuild without re-reading every turn.
+ */
+export function loadOrchestration(): OrchestrationConfig | undefined {
+	const path = orchestrationConfigPath();
+	if (!existsSync(path)) {
+		cached = undefined;
+		return undefined;
+	}
+	const mtimeMs = statSync(path).mtimeMs;
+	if (cached && cached.path === path && cached.mtimeMs === mtimeMs) return cached.config;
+	const config = parseOrchestration(readFileSync(path, "utf-8"), path);
+	cached = { path, mtimeMs, config };
+	return config;
+}
+
+/** Drop the memoized config so the next load re-reads the file. */
+export function invalidateOrchestrationCache(): void {
+	cached = undefined;
+}
+
+/**
+ * Render the ladder as prompt text. Deterministic for a given config so the
+ * section stays stable across turns and the transcript's section diff is quiet.
+ */
+export function renderOrchestration(config: OrchestrationConfig): string | undefined {
+	// The unconfigured default (no brain, no arms) renders to nothing: an empty
+	// section would read as a broken ladder and tell the brain it has no models
+	// to spend. Omitting the section entirely is the honest state — plain pi,
+	// until /setup writes the arms.
+	if (config.brain === undefined) return undefined;
+
+	const lines: string[] = [`Orchestrator model (yours): ${config.brain}`, ""];
+	lines.push(
+		"Worker ladder — arms are priority-ordered (first = the default arm, spend the bulk there); pick the arm per dispatch with `args.model`:",
+	);
+	for (const worker of config.workers) {
+		const isAvailable = worker.available !== false;
+		const mark = isAvailable ? "" : " — UNAVAILABLE on this host, never route here";
+		lines.push(`- ${worker.id}${worker.harness ? ` [harness: ${worker.harness}]` : ""}${mark}`);
+		if (!isAvailable && worker.availabilityNote) {
+			lines.push(`  - reason: ${worker.availabilityNote}`);
+		}
+		for (const entry of worker.models) {
+			lines.push(`  - ${entry.model} — roles: ${entry.roles.join(", ")} — ${entry.when}`);
+		}
+	}
+
+	const routing: string[] = [];
+	if (config.routing.escalateBelow !== undefined) {
+		routing.push(
+			`treat a router confidence below ${config.routing.escalateBelow} as advisory and re-justify it yourself`,
+		);
+	}
+	if (config.routing.maxDispatchesPerTurn !== undefined) {
+		routing.push(`at most ${config.routing.maxDispatchesPerTurn} dispatches per turn`);
+	}
+	if (routing.length > 0) {
+		lines.push("", `Routing: ${routing.join("; ")}.`);
+	}
+	if (config.review.crossVendor) {
+		lines.push("", "Review: a review node MUST run on a different vendor than the node it reviews.");
+	}
+
+	lines.push("", `This ladder is configuration, not advice: read it from ${orchestrationConfigPath()}.`);
+	return lines.join("\n");
+}
+
+/**
+ * Every model id in the ladder, for cross-checking against the configured
+ * providers (e.g. "is this arm actually reachable on this host?").
+ */
+export function orchestrationModels(config: OrchestrationConfig): string[] {
+	// `brain` is `undefined` only for the unconfigured default (no brain, no
+	// arms), which carries no model refs at all.
+	const models = config.brain === undefined ? [] : [config.brain];
+	for (const worker of config.workers) {
+		for (const entry of worker.models) models.push(entry.model);
+	}
+	return models;
+}
+
+/** Split a `provider/model` id into its halves, or undefined when malformed. */
+export function splitModelRef(ref: string): { provider: string; id: string } | undefined {
+	const slash = ref.indexOf("/");
+	if (slash <= 0 || slash === ref.length - 1) return undefined;
+	return { provider: ref.slice(0, slash), id: ref.slice(slash + 1) };
+}
