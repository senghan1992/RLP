#!/bin/sh
# rlp update — update RLP itself, then the pi fork it runs on.
#
# "Update" means what a user means by it: both halves. RLP's own checkout moves
# to the newest release, and the harness fork moves to the newest upstream with
# the RLP patch re-applied on top. Updating only the fork — which is all this
# did before — left the tool one release behind with nothing saying so.
#
# Why the fork half is a script and not a documented recipe: the documented flow
# (`git fetch origin && git merge origin/main`) has never actually worked on
# this checkout. It was cloned with `--depth 1`, and a shallow repository
# cannot merge. This script unshallows first, then merges, then proves the RLP
# surface survived, then rebuilds.
#
# Guarantees, in priority order:
#   1. Never lose work. A dirty tree is refused — in either repository — the
#      pre-update commit is printed so a rollback is one `git reset --hard <sha>`
#      away, and a checkout ahead of origin is kept: never moved backward.
#   2. Never leave half an update. A conflicted merge is aborted, not left
#      pending for the next command to trip over, and the agent dir is
#      re-synced so the installed extensions match the engine.
#   3. Never claim success unverified. The RLP markers, the typecheck and the
#      build all have to pass, and a failure in any of them is a failure of
#      this command.
#
# Usage:
#   rlp update                  update RLP, then the fork: fetch, merge, verify, rebuild
#   rlp update --check          report what would happen; change nothing
#   rlp update --no-self        only the fork (RLP's own checkout is left alone)
#   rlp update --self-ref <r>   which RLP ref to move to (default: newest v* tag)
#   rlp update --to <ref>       merge a different upstream fork ref (default origin/main)
#   rlp update --no-build       skip the rebuild (merge + verify only)
#   rpi update                  the same command — one updater, two spellings
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
FORK="$ROOT/fork/pi"
PY="$(sh "$ROOT/scripts/svc-py" 2>/dev/null || true)"

CHECK=0
DO_BUILD=1
DO_SELF=1
SELF_REF=""
TARGET="origin/main"

while [ $# -gt 0 ]; do
  case "$1" in
    --check|--dry-run) CHECK=1 ;;
    --no-build) DO_BUILD=0 ;;
    --no-self) DO_SELF=0 ;;
    --self-ref) shift; SELF_REF="${1:-}" ;;
    --to) shift; TARGET="${1:-}" ;;
    -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "rlp update: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

say()  { printf '%s\n' "$*"; }
step() { say ""; say "── $* ────────────────────────────────────────"; }
die()  { say ""; say "update failed: $*" >&2; exit 1; }

# --- 0. RLP itself --------------------------------------------------------
#
# Runs before anything else and then re-execs, because a script that updates
# its own file cannot keep running from it: the shell reads the rest of the
# script from disk as it goes, and the rest would be the new version spliced
# into the old one's execution. `RLP_SELF_UPDATED` is what stops the re-exec
# from looping.
#
# A checkout with local changes is left alone and said so. Somebody working on
# RLP is the likeliest person to run this, and silently resetting their tree
# would be the worst thing this command could do.
self_update() {
  [ -d "$ROOT/.git" ] || { say "  RLP is not a git checkout here — skipping (installed from an archive?)"; return 0; }
  if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
    say "  RLP's checkout has local changes, so it is left exactly as it is:"
    git -C "$ROOT" status --short 2>/dev/null | head -5 | sed 's/^/    /'
    say "  (this is the right answer if you are working on RLP; the fork half continues)"
    return 0
  fi
  git -C "$ROOT" remote get-url origin >/dev/null 2>&1 || {
    say "  RLP's checkout has no 'origin' remote — skipping"
    return 0
  }

  REF="$SELF_REF"
  if [ -z "$REF" ]; then
    # Same rule as install.sh: the newest release tag, sorted field by field so
    # v0.10.0 beats v0.9.0. No tags means stay on the current branch.
    git -C "$ROOT" fetch --quiet --tags origin 2>/dev/null || true
    REF=$(git -C "$ROOT" tag --list 'v[0-9]*' |
      sed -n 's|^v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' |
      sort -t. -k1,1n -k2,2n -k3,3n | tail -1 | sed 's/^/v/')
    if [ -z "$REF" ]; then
      REF=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
      [ "$REF" = "HEAD" ] && REF=main
      say "  no release tag yet — tracking $REF"
    fi
  fi
  # A local branch stays a branch when it moves: detaching to origin/$REF is
  # how a checkout ends up "HEAD detached at …" with the user's branch left
  # behind — the exact confusion this script exists to prevent. A tag (or a
  # bare sha) still detaches: following a release means leaving the branch.
  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$REF"; then
    REF_KIND=branch
  else
    REF_KIND=detached
  fi

  HERE=$(git -C "$ROOT" describe --tags --always 2>/dev/null || echo "?")
  git -C "$ROOT" fetch --quiet origin "$REF" 2>/dev/null ||
    git -C "$ROOT" fetch --quiet --depth 1 origin "$REF" 2>/dev/null ||
    { say "  could not fetch $REF from origin (no network?) — keeping $HERE"; return 0; }
  # `^{commit}` peels the annotated tag. Without it `rev-parse FETCH_HEAD`
  # returns the *tag object*, which never equals HEAD's commit — so an
  # already-current install was told an update was available and did a pointless
  # detach, every time. `scripts/release` writes annotated tags, so this was not
  # an edge case: it was the only case.
  WANT=$(git -C "$ROOT" rev-parse "FETCH_HEAD^{commit}")
  if [ "$REF_KIND" = branch ] &&
     [ "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)" != "$REF" ]; then
    # Detached HEAD (or parked on another branch): get back onto the tracked
    # branch before deciding anything — the branch tip, not wherever the
    # detached HEAD sits, is "where this checkout is". The tree is known clean
    # (guarded above), so the switch cannot lose work.
    if [ "$CHECK" = 1 ]; then
      say "  --check: would run: git -C $ROOT checkout $REF"
      HAVE=$(git -C "$ROOT" rev-parse "$REF^{commit}")
    else
      git -C "$ROOT" checkout -q "$REF" || die "could not check out $REF"
      say "  was off the $REF branch — back on $REF"
      HAVE=$(git -C "$ROOT" rev-parse "HEAD^{commit}")
    fi
  else
    HAVE=$(git -C "$ROOT" rev-parse "HEAD^{commit}")
  fi
  if [ "$WANT" = "$HAVE" ]; then
    say "  RLP is already at $REF ($HERE)"
    return 0
  fi
  if [ -z "$SELF_REF" ]; then
    # Implicit tracking never moves the checkout to an older commit. A local
    # branch ahead of origin used to be "updated" backward to origin's older
    # state — and the re-exec below then synced the agent dir from there, so
    # the regression reached the installed extensions too. An explicit
    # --self-ref is a deliberate move and skips both guards.
    if git -C "$ROOT" merge-base --is-ancestor "$WANT" "$HAVE" 2>/dev/null; then
      AHEAD_N=$(git -C "$ROOT" rev-list --count "$WANT..$HAVE" 2>/dev/null || echo "?")
      say "  this checkout is $AHEAD_N commit(s) ahead of origin/$REF — keeping it."
      say "  (an update never moves a checkout backward; git push publishes the"
      say "   local work, or rlp update --self-ref $REF forces the move anyway)"
      return 0
    fi
    if ! git -C "$ROOT" merge-base --is-ancestor "$HAVE" "$WANT" 2>/dev/null; then
      AHEAD_N=$(git -C "$ROOT" rev-list --count "$WANT..$HAVE" 2>/dev/null || echo "?")
      BEHIND_N=$(git -C "$ROOT" rev-list --count "$HAVE..$WANT" 2>/dev/null || echo "?")
      say "  this checkout has diverged from origin/$REF ($AHEAD_N local, $BEHIND_N remote) — not moving."
      say "  resolve it by hand, or name the target: rlp update --self-ref <ref>"
      return 0
    fi
  fi
  BEHIND_N=$(git -C "$ROOT" rev-list --count "$HAVE..$WANT" 2>/dev/null || echo "?")
  say "  RLP  $HERE  ->  $REF ($BEHIND_N commit(s) behind)"
  if [ "$CHECK" = 1 ]; then
    if [ "$REF_KIND" = branch ] && [ -z "$SELF_REF" ]; then
      say "  --check: would run: git -C $ROOT merge --ff-only $WANT"
    else
      say "  --check: would run: git -C $ROOT checkout --detach $WANT"
    fi
    return 0
  fi
  say "  rollback    git -C $ROOT checkout --detach $HAVE"
  if [ "$REF_KIND" = branch ] && [ -z "$SELF_REF" ]; then
    # Fast-forward the branch itself: HEAD stays on $REF, never detached.
    git -C "$ROOT" merge -q --ff-only "$WANT" || die "could not fast-forward $REF to origin/$REF"
  else
    git -C "$ROOT" checkout -q --detach "$WANT" || die "could not check out $REF"
  fi
  # Extensions, skills and the ladder belong to the version, so they move with
  # it. Without this the new engine would run against the old extensions and
  # nothing would report the mismatch.
  sh "$ROOT/scripts/sync-agent-dir" "$ROOT" || die "agent dir sync failed after the RLP update"
  say ""
  say "  RLP updated — re-running the rest of the update from the new version"
  RLP_SELF_UPDATED=1
  export RLP_SELF_UPDATED
  ARGS="--no-self"
  [ "$DO_BUILD" = 1 ] || ARGS="$ARGS --no-build"
  [ "$TARGET" = "origin/main" ] || ARGS="$ARGS --to $TARGET"
  # shellcheck disable=SC2086
  exec sh "$ROOT/scripts/rlp-update" $ARGS
}

if [ "$DO_SELF" = 1 ] && [ -z "${RLP_SELF_UPDATED:-}" ]; then
  step "0/7  RLP itself"
  self_update
fi

# A missing fork used to surface as a bare `cd: can't cd to …/fork/pi`, which
# names the symptom and not the fix. It happens for real: a half-finished
# install, or an RLP fetched as an archive where the fork was never cloned.
[ -d "$FORK/.git" ] || die "the harness fork is not here yet ($FORK).
  RLP itself is fine — only the fork half of the update needs it.
  Run: sh $ROOT/scripts/install.sh"

cd "$FORK"

# RLP's own fingerprints in the fork. If upstream refactors past one of these,
# the update is "successful" in git terms and broken in practice — so each one
# is checked explicitly rather than inferred from a clean merge.
check_markers() {
  missing=""
  f=packages/coding-agent/src
  grep -q 'RPI_DEFAULT_MODEL'        "$f/core/settings-manager.ts" 2>/dev/null || missing="$missing RPI_DEFAULT_MODEL"
  grep -q 'isManagedSession'         "$f/core/settings-manager.ts" 2>/dev/null || missing="$missing isManagedSession"
  grep -q 'rlp_orchestration'        "$f/core/system-prompt.ts"     2>/dev/null || missing="$missing rlp_orchestration"
  grep -q '"orchestration"'          "$f/core/slash-commands.ts"    2>/dev/null || missing="$missing /orchestration"
  grep -q 'BUILTIN_SLASH_COMMANDS'   "$f/index.ts"                  2>/dev/null || missing="$missing BUILTIN_SLASH_COMMANDS-export"
  grep -q 'handleOrchestrationCommand' "$f/modes/interactive/interactive-mode.ts" 2>/dev/null || missing="$missing /orchestration-handler"
  grep -q 'collectAutoSkillEntries(userAgentsSkillsDir' "$f/core/package-manager.ts" 2>/dev/null || missing="$missing stock-skill-discovery"
  [ -f "$f/core/rlp-orchestration.ts" ] || missing="$missing core/rlp-orchestration.ts"
  if [ -n "$missing" ]; then
    say ""
    say "RLP surface lost in the merge:$missing"
    say ""
    say "git says the merge is clean, but RLP no longer has:$missing"
    say "Upstream probably refactored the file. Inspect and re-apply by hand:"
    say "  cd $FORK && git diff ${PREV_SHA:-HEAD} HEAD -- $f"
    return 1
  fi
  say "  RLP surface intact: 9 markers, the ladder module, and the /rlp commands"
  return 0
}

# --- 1. preflight ---------------------------------------------------------
step "1/7  preflight"
PREV_SHA=$(git rev-parse --short HEAD)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
PI_VERSION=$(node -p "require('$FORK/packages/coding-agent/package.json').version" 2>/dev/null || echo "?")
say "  fork        $FORK"
say "  branch      $BRANCH"
say "  rpi version $PI_VERSION"
say "  rollback    git reset --hard $PREV_SHA   (from $FORK)"

[ "$BRANCH" = "rlp" ] || die "expected to be on the 'rlp' branch, found '$BRANCH'"

if [ -f .git/MERGE_HEAD ]; then
  die "a merge is already in progress (MERGE_HEAD present). Finish or abort it first:
  git merge --abort   # or: git reset --hard $PREV_SHA"
fi
if [ -n "$(git status --porcelain)" ]; then
  say ""
  say "  the working tree has uncommitted changes:"
  git status --short | head -10 | sed 's/^/    /'
  die "commit or stash them first — an update must start from a known state"
fi
say "  working tree clean"

# --- 2. history -----------------------------------------------------------
step "2/7  history"
if [ -f .git/shallow ]; then
  say "  shallow clone (depth 1) — this is why the documented"
  say "  'git merge origin/main' never worked here. Unshallowing."
  if [ "$CHECK" = 1 ]; then
    say "  --check: would run: git fetch --unshallow origin"
  else
    say "  running: git fetch --unshallow origin (this downloads full history, once)"
    git fetch --unshallow --quiet origin 2>&1 | sed 's/^/    /' || die "unshallow failed"
    say "  unshallowed: $(git rev-list --count HEAD) commits now local"
  fi
else
  say "  full history ($(git rev-list --count HEAD) commits)"
fi

# --- 3. fetch -------------------------------------------------------------
step "3/7  fetch"
git fetch --quiet origin 2>&1 | sed 's/^/  /' || die "fetch failed (no network?)"
BEHIND=$(git rev-list --count "HEAD..$TARGET" 2>/dev/null || echo 0)
AHEAD=$(git rev-list --count "$TARGET..HEAD" 2>/dev/null || echo 0)
say "  behind $BEHIND commit(s), ahead $AHEAD (RLP's own work)"
NEW_PI=$(git show "$TARGET:packages/coding-agent/package.json" 2>/dev/null | node -p "JSON.parse(require('fs').readFileSync(0,'utf8')).version" 2>/dev/null || echo "?")
say "  upstream rpi version $NEW_PI (local $PI_VERSION)"

if [ "$BEHIND" = "0" ]; then
  say "  already up to date with $TARGET"
  step "summary"
  say "  nothing to merge; re-verifying and rebuilding anyway"
else
  say "  commits touching the files RLP modifies:"
  git log --oneline --no-decorate "HEAD..$TARGET" -- \
    packages/coding-agent/src/core/settings-manager.ts \
    packages/coding-agent/src/core/system-prompt.ts \
    packages/coding-agent/src/core/slash-commands.ts \
    packages/coding-agent/src/core/package-manager.ts \
    packages/coding-agent/src/index.ts \
    packages/coding-agent/src/modes/interactive/interactive-mode.ts \
    2>/dev/null | head -12 | sed 's/^/    /' || true
fi

# --- 4. merge -------------------------------------------------------------
step "4/7  merge $TARGET"
if [ "$CHECK" = 1 ]; then
  say "  --check: would run: git merge --no-edit $TARGET"
elif [ "$BEHIND" = "0" ]; then
  say "  nothing to merge"
else
  # A merge commit needs a committer identity, and a fresh machine — a CI
  # runner, a container, a new laptop — often has none. Without this the merge
  # failed on "Committer identity unknown" and was reported as a *conflict*,
  # which is a false diagnosis of the one thing this step exists to detect.
  # `-c` only supplies a fallback: an existing identity is left alone, because
  # the merge commit should carry the name of whoever ran the update when there
  # is one to carry.
  # Supplied as environment variables rather than `git -c name=value`, because
  # a `-c` pair held in a shell variable word-splits on the space in the name
  # and git then reads the second word as a subcommand. Nothing in POSIX sh
  # makes that safe; these do, and git honours them only when no identity is
  # configured for real.
  if ! git config user.email >/dev/null 2>&1 || ! git config user.name >/dev/null 2>&1; then
    say "  no git identity configured here — the merge commit will say 'RLP updater'"
    GIT_AUTHOR_NAME="RLP updater"
    GIT_AUTHOR_EMAIL="rlp@localhost"
    GIT_COMMITTER_NAME="RLP updater"
    GIT_COMMITTER_EMAIL="rlp@localhost"
    export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
  fi

  # Record and reuse conflict resolutions. This fork re-merges upstream into
  # the same handful of RLP-touched files, so the same regions conflict again
  # and again; rerere replays a resolution made once (by hand after an abort,
  # or by a previous merge) the next time the identical conflict appears, and
  # says "Resolved … using previous resolution" when it does.
  git config rerere.enabled true

  say "  merging (this may conflict; RLP's changes touch files upstream edits too)"
  if ! git merge --no-edit --no-stat "$TARGET"; then
    UNMERGED=$(git diff --name-only --diff-filter=U)
    say ""
    if [ -n "$UNMERGED" ]; then
      say "  CONFLICTS:"
      printf '%s\n' "$UNMERGED" | sed 's/^/    /'
      say ""
      say "  aborting, so the tree is left clean and the old build keeps working"
      git merge --abort 2>/dev/null || true
      die "conflict merging $TARGET into rlp. The RLP side is committed at $PREV_SHA.
  To resolve manually:
    git merge $TARGET      # then fix the listed files
    git commit             # then: sh scripts/install.sh
  To skip the update entirely:
    git reset --hard $PREV_SHA"
    fi
    # No unmerged paths means the merge failed for some other reason. Saying
    # "conflict" here would send someone looking for one that is not there.
    say "  the merge failed, but no file is in conflict — so this is not a"
    say "  content problem. git's own message is above."
    git merge --abort 2>/dev/null || true
    die "git could not complete the merge of $TARGET (see its message above).
  Nothing was changed; the RLP side is still at $PREV_SHA."
  fi
  say "  merged cleanly"
fi

# --- 5. verify the RLP surface -------------------------------------------
step "5/7  verify"
check_markers || die "RLP surface did not survive the update (see above); the tree is intact, rebuild with: git reset --hard $PREV_SHA"

# --- 6. build -------------------------------------------------------------
step "6/7  build"
if [ "$DO_BUILD" = 0 ] || [ "$CHECK" = 1 ]; then
  say "  skipped (--no-build / --check)"
else
  say "  npm install + npm run build (a few minutes)"
  (npm install --ignore-scripts --silent && npm run build --silent) >/tmp/rlp-update-build.log 2>&1 || {
    tail -30 /tmp/rlp-update-build.log | sed 's/^/    /'
    die "build failed; the merged tree is left in place for inspection.
  Build log: /tmp/rlp-update-build.log
  To go back to the working version: git reset --hard $PREV_SHA"
  }
  say "  built"
fi

# --- 7. reinstall + report ------------------------------------------------
step "7/7  install + report"
if [ "$CHECK" = 1 ] || [ "$DO_BUILD" = 0 ]; then
  say "  skipped"
else
  say "  refreshing wrappers, extensions and the agent spec"
  sh "$ROOT/scripts/install.sh" >/tmp/rlp-update-install.log 2>&1 || {
    tail -20 /tmp/rlp-update-install.log | sed 's/^/    /'
    die "install failed; see /tmp/rlp-update-install.log"
  }
  say "  installed"
fi

step "summary"
FINAL_PI=$(node -p "require('$FORK/packages/coding-agent/package.json').version" 2>/dev/null || echo '?')
NEW_HEAD=$(git rev-parse --short HEAD)
if [ "$CHECK" = 1 ]; then
  say "  rpi version   $PI_VERSION -> $NEW_PI (would, once merged)"
  say "  fork commit   $PREV_SHA -> (would advance to $TARGET)"
  say ""
  say "  --check made no working-tree changes. Run without it to apply."
  say "  Note: it did fetch, so 'behind N' above is current."
else
  say "  rpi version   $PI_VERSION -> $FINAL_PI"
  say "  fork commit   $PREV_SHA -> $NEW_HEAD"
  say "  rollback      git reset --hard $PREV_SHA   (then: sh scripts/install.sh)"
fi
# The version actually running now, from the tool itself rather than from this
# script's idea of it: `rlp version` is the line to paste into a bug report,
# and printing it here is how someone learns it exists.
if [ -x "$PY" ]; then
  say ""
  (cd "$ROOT/rlp-svc" && "$PY" -m rlp_svc version 2>/dev/null | sed 's/^/  /') || true
fi
say ""
say "  verify it yourself:  sh scripts/selftest.sh --fast"
